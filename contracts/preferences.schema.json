{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Signal Brief preferences (config/preferences.json)",
  "type": "object",
  "required": ["version", "language", "lenses", "topics", "momentum", "counts", "refresh"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "updated": { "type": "string", "format": "date" },
    "language": { "const": "en" },
    "lenses": {
      "type": "object", "required": ["practical", "broad"], "additionalProperties": false,
      "patternProperties": { ".*": { "type": "object", "required": ["label", "weight"], "properties": { "label": { "type": "string" }, "weight": { "type": "number", "minimum": 0, "maximum": 1 }, "description": { "type": "string" } } } }
    },
    "topics": { "type": "object", "properties": { "boost": { "type": "array", "items": { "type": "string" } }, "mute": { "type": "array", "items": { "type": "string" } } } },
    "momentum": { "type": "object", "required": ["newHours", "buildingDays", "shiftDays"], "properties": { "newHours": { "type": "integer" }, "buildingDays": { "type": "integer" }, "shiftDays": { "type": "integer" } } },
    "counts": { "type": "object", "required": ["top3", "minItems", "maxItems", "voices"], "properties": { "top3": { "const": 3 }, "minItems": { "type": "integer", "minimum": 3 }, "maxItems": { "type": "integer" }, "voices": { "type": "integer" } } },
    "refresh": { "type": "object", "required": ["timezone", "times"], "properties": { "timezone": { "type": "string" }, "times": { "type": "array", "items": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" } } } },
    "quality": { "type": "object" }
  },
  "additionalProperties": false
}
