{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "How-tos: a batch Editor publishes (site/public/api/howto/latest.json) and the deduplicated library (site/public/api/howto/library.json)",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "howtos"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "runId": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-\\d{4}$" },
    "howtos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "dedupeKey", "title", "what", "kind", "copy", "whenToUse", "source", "author", "tags", "quality", "verbatim", "addedAt"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "dedupeKey": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Same technique = same key, whoever posted it. Only the best version per key is kept." },
          "title": { "type": "string", "maxLength": 70, "description": "<= 8 words, starts with a verb" },
          "what": { "type": "string", "maxLength": 140, "description": "One line: what it is and what you get" },
          "kind": { "enum": ["prompt", "steps"] },
          "copy": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "maxLength": 600 }, "description": "prompt: one element, the exact text to paste. steps: one element per step." },
          "whenToUse": { "type": "string", "maxLength": 140 },
          "source": { "type": "object", "required": ["name", "url"], "properties": { "name": { "type": "string" }, "url": { "type": "string", "format": "uri" } } },
          "author": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "handle": { "type": "string" } } },
          "alsoFrom": { "type": "array", "items": { "type": "object", "required": ["name", "url"], "properties": { "name": { "type": "string" }, "url": { "type": "string", "format": "uri" } } }, "description": "Other sources that added to this tip" },
          "tags": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
          "quality": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Editor's score; the higher one wins a dedupe" },
          "verbatim": { "type": "boolean", "description": "true: copy is quoted from the source. false: steps condensed from the source; no added claims." },
          "briefItem": { "type": "object", "required": ["briefId", "itemId"], "properties": { "briefId": { "type": "string" }, "itemId": { "type": "string" } } },
          "addedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
