{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Signal candidates (pipeline/candidates/YYYY-MM-DD-HHmm.json), written by Signal, read by Editor",
  "type": "object",
  "required": ["schemaVersion", "runId", "generatedAt", "configVersions", "candidates"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "runId": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-\\d{4}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "configVersions": { "type": "object", "required": ["sources", "preferences"], "properties": { "sources": { "type": "string" }, "preferences": { "type": "string" } } },
    "window": { "type": "object", "properties": { "from": { "type": "string", "format": "date-time" }, "to": { "type": "string", "format": "date-time" } } },
    "sourceNotes": { "type": "array", "items": { "type": "string" }, "description": "Feeds that failed or were empty this run." },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "lens", "summary", "source", "publishedAt", "care", "proof"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "lens": { "enum": ["practical", "broad"] },
          "summary": { "type": "string", "description": "Raw facts in English. No spin, no invented numbers." },
          "facts": { "type": "array", "items": { "type": "string" } },
          "source": { "type": "object", "required": ["name", "url", "type"], "properties": { "name": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "type": { "enum": ["x", "rss", "arxiv", "hn", "blog"] }, "handle": { "type": "string" } } },
          "related": { "type": "array", "items": { "type": "object", "required": ["name", "url"], "properties": { "name": { "type": "string" }, "url": { "type": "string", "format": "uri" } } } },
          "publishedAt": { "type": "string", "format": "date-time" },
          "metrics": { "type": "object", "properties": { "likes": { "type": "integer" }, "replies": { "type": "integer" }, "reposts": { "type": "integer" }, "points": { "type": "integer" } } },
          "care": { "type": "integer", "minimum": 1, "maximum": 5 },
          "proof": { "type": "integer", "minimum": 1, "maximum": 5 },
          "imageHint": { "type": "string", "format": "uri", "description": "X post URL or page with an og:image to capture." },
          "bestReply": { "type": "object", "required": ["handle", "quote", "url"], "properties": { "handle": { "type": "string" }, "quote": { "type": "string", "description": "Verbatim." }, "url": { "type": "string", "format": "uri" }, "followers": { "type": "integer" }, "likes": { "type": "integer" } } },
          "firstSeen": { "type": "string", "format": "date", "description": "First run that saw this story; Editor uses it for momentum." }
        }
      }
    }
  }
}
