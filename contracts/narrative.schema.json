{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Weekly narrative (site/public/api/narrative/<id>.json and latest.json), written by Editor, read by the site",
  "type": "object",
  "required": ["schemaVersion", "id", "publishedAt", "window", "headline", "summary", "threads"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Publish date in Bogotá. A mid-week refresh replaces that week's file under a new date." },
    "publishedAt": { "type": "string", "format": "date-time" },
    "window": { "type": "object", "required": ["from", "to"], "additionalProperties": false, "properties": { "from": { "type": "string", "format": "date" }, "to": { "type": "string", "format": "date" } } },
    "headline": { "type": "string", "minLength": 10, "maxLength": 90, "description": "<= 12 words. The one shift of the week." },
    "summary": { "type": "string", "minLength": 200, "maxLength": 1100, "description": "4-6 sentences: what is shifting, why, what it means for the reader. Facts must come from the evidence items." },
    "threads": {
      "type": "array", "minItems": 3, "maxItems": 5,
      "items": {
        "type": "object", "required": ["title", "line", "evidence"], "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "maxLength": 40, "description": "<= 5 words" },
          "line": { "type": "string", "maxLength": 160, "description": "<= 25 words: the dot this thread connects" },
          "evidence": {
            "type": "array", "minItems": 1, "maxItems": 6,
            "items": { "type": "object", "required": ["briefId", "itemId"], "additionalProperties": false, "properties": { "briefId": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-\\d{4}$" }, "itemId": { "type": "string" } } }
          }
        }
      }
    }
  }
}
